  // 골인 전 순위는 실제 하강 진행도 순서로만 계산한다.
  // 같은 높이에서 공들이 맞붙었을 때 목록이 무작위로 뒤집히지 않도록 직전 순위를 동점 기준으로 유지한다.
  const liveRows=liveSource.filter(b=>!b.done).map(b=>({...b,live:true}));
  liveRows.sort((a,b)=>{
   const aw=a.waiting?1:0,bw=b.waiting?1:0;
   if(aw!==bw)return aw-bw; // 아직 출발하지 않은 공은 항상 뒤쪽
   const ay=Number(a.y)||0,by=Number(b.y)||0;
   if(Math.abs(by-ay)>.75)return by-ay; // 더 아래에 내려온 공이 앞순위
   const avy=Number(a.vy)||0,bvy=Number(b.vy)||0;
   if(Math.abs(bvy-avy)>.025)return bvy-avy; // 같은 높이면 아래 방향 속도가 빠른 공 우선
   const ap=liveRankMemory.get(String(a.ballId))??999999;
