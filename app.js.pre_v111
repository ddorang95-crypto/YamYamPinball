   bum.push({x:225,y:y+45,r:27+mr()*8,kick:1.15+mr()*.17},{x:675,y:y-45,r:27+mr()*8,kick:1.15+mr()*.17});
  }else if(kind===5){
   // 엇갈린 회전문: 통과 타이밍에 따라 좌우 진로가 크게 갈린다.
