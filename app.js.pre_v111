 const mapScale=W/BASE_W,mapCx=W/2,baseCx=BASE_W/2,scaleX=x=>mapCx+(x-baseCx)*mapScale;
 s=s.map(g=>({...g,x1:scaleX(g.x1),x2:scaleX(g.x2)}));
 p=p.map(q=>({...q,x:scaleX(q.x)}));
 bum=bum.map(q=>({...q,x:scaleX(q.x)}));
 kick=kick.map(q=>({...q,x:scaleX(q.x)}));
 rot=rot.map(q=>({...q,x:scaleX(q.x),len:q.len*mapScale}));
 decor=decor.map(q=>({...q,x:scaleX(q.x)}));
 routePts=routePts.map(([x,y])=>[scaleX(x),y]);
 routeWidths=routeWidths.map(w=>w*mapScale);
 // 전 맵 공통 안전 보정: 회전 장애물은 현재 코스 폭의 46%보다 길어질 수 없다.
 // 어느 각도로 돌아도 반대편 벽까지 닿지 않아 완전 차단이 생기지 않는다.
 const routeAtY=(yy)=>{
  if(!routePts?.length)return{x:450,w:620};let i=0;while(i<routePts.length-2&&yy>routePts[i+1][1])i++;
  const a=routePts[i],b=routePts[Math.min(i+1,routePts.length-1)],t=clamp((yy-a[1])/Math.max(1,b[1]-a[1]),0,1);
  return{x:a[0]+(b[0]-a[0])*t,w:(routeWidths[i]||520)+((routeWidths[Math.min(i+1,routeWidths.length-1)]||520)-(routeWidths[i]||520))*t};
 };
 rot=rot.map(r=>{const lane=routeAtY(r.y),maxLen=Math.max(82,lane.w*.46);r.len=Math.min(r.len,maxLen);r.x=clamp(r.x,lane.x-lane.w*.27,lane.x+lane.w*.27);return r});
 // 같은 높이에 범퍼가 과도하게 몰리는 조합도 제거한다. 중앙에는 최소 공 4개 폭의 통로를 유지한다.
 bum=bum.filter((q,idx)=>{const lane=routeAtY(q.y),centerGap=Math.abs(q.x-lane.x);if(centerGap<92&&q.r>30){const peers=bum.filter((o,j)=>j!==idx&&Math.abs(o.y-q.y)<95&&Math.abs(o.x-lane.x)<150);return peers.length<2}return true});
 // 공통 결승: 급하게 좁아지는 V자가 아니라, 넓은 사다리꼴 집결부 → 완만한 바닥 → 중앙 통로.
 const mergeTop=finalTop,gateY=worldH-500,exitX=W/2,entryY=gateY+70,chuteHalf=82,chuteLeft=exitX-chuteHalf,chuteRight=exitX+chuteHalf;
 // 상단 폭을 넉넉히 유지하고, 아래쪽까지 완만하게 줄어드는 사다리꼴 벽을 만든다.
 const trapShoulderY=mergeTop+130,trapFloorY=gateY-105;
 const edgeL=90,edgeR=W-90;
 s.push(seg(edgeL,mergeTop,edgeL+12,trapShoulderY,.43),seg(edgeR,mergeTop,edgeR-12,trapShoulderY,.43));
 s.push(seg(edgeL+12,trapShoulderY,235,trapFloorY,.49),seg(edgeR-12,trapShoulderY,W-235,trapFloorY,.49));
 // 바닥을 거의 평평한 얕은 V 형태로 넓게 받아 공이 한 점에 갑자기 뭉치지 않게 한다.
 s.push(seg(235,trapFloorY,exitX-150,entryY-18,.58),seg(W-235,trapFloorY,exitX+150,entryY-18,.58));
 s.push(seg(exitX-150,entryY-18,chuteLeft,entryY,.60),seg(exitX+150,entryY-18,chuteRight,entryY,.60));
 // 마지막 통로도 기존보다 조금 넓혀 공이 회전봉 주변에서 덜 막히도록 한다.
 s.push(seg(chuteLeft,entryY,chuteLeft,worldH+35,.28),seg(chuteRight,entryY,chuteRight,worldH+35,.28));
 // 모든 내부 구조물은 외벽 안쪽 안전영역에서만 존재하도록 마지막에 강제 보정한다.
 // 중심점뿐 아니라 회전 반경과 구조물 크기까지 계산해 어느 각도에서도 밖으로 나오지 않는다.
 const safeL=112,safeR=W-112,safeT=12,safeB=worldH-12;
 for(let i=2;i<s.length;i++){const g=s[i];g.x1=clamp(g.x1,safeL,safeR);g.x2=clamp(g.x2,safeL,safeR);g.y1=clamp(g.y1,safeT,safeB+40);g.y2=clamp(g.y2,safeT,safeB+40)}
 const keepCircle=q=>{const r=Math.max(0,Number(q.r)||0),m=r+8;q.x=clamp(q.x,safeL+m,safeR-m);q.y=clamp(q.y,safeT+m,safeB-m);return q};
 p=p.map(keepCircle);bum=bum.map(keepCircle);kick=kick.map(keepCircle);
 rot=rot.map(r=>{const edge=Math.max(28,Math.min(r.x-safeL,safeR-r.x,r.y-safeT,safeB-r.y));r.len=Math.min(r.len,Math.max(48,edge*2-18));r.x=clamp(r.x,safeL+r.len/2+9,safeR-r.len/2-9);r.y=clamp(r.y,safeT+r.len/2+9,safeB-r.len/2-9);return r});
 const gate={pivotX:exitX-112,pivotY:entryY-34,len:300,a:mr()*Math.PI*2,spd:.024,centerPivot:true};
 // 마지막 핀볼대는 막대 정중앙을 회전축으로 사용한다. 양쪽 끝이 같은 반경으로 회전한다.
 const gateHalfEdge=Math.max(34,Math.min(gate.pivotX-safeL,safeR-gate.pivotX,gate.pivotY-safeT,safeB-gate.pivotY));gate.len=Math.min(gate.len,gateHalfEdge*2-24);
 // 광폭 맵 비율에 맞춰 모든 핀볼 오브젝트도 함께 확대한다.
 p.forEach(q=>q.r*=1.18);
 bum.forEach(q=>q.r*=1.18);
 rot.forEach(q=>q.len*=1.04);
 if(gate)gate.len*=1.12;
 return{s,p,rot,bum,kick,decor,cameraStops,routePts,routeWidths,worldH,finishY:worldH-16,finishGateY:mergeTop,finishX:exitX,finalZone:{top:mergeTop,left:edgeL,right:edgeR,pocketTop:trapShoulderY,trapFloorY,gateY,cleanDropTop:entryY,chuteLeft,chuteRight},gate}
}
function startPhysics(){const physicsEpoch=++lifecycleEpoch;lastRace=state.raceId;const rr=rnd((state.seed||1)+(state.shuffleNonce||0)*9973),raw=balls();for(let i=raw.length-1;i>0;i--){const j=Math.floor(rr()*(i+1));[raw[i],raw[j]]=[raw[j],raw[i]]}
 // 공을 한 지점에서 동시에 쏟지 않고 넓은 폭에 분산한 뒤 아주 짧은 시간차로 출발시킨다.
 const cols=Math.max(12,Math.min(34,Math.ceil(Math.sqrt(Math.max(1,raw.length)*3.4))));
 const now=performance.now(),targetMs=clamp(65000+raw.length*210,70000,135000),spacing=R*2+7;
 const arr=raw.map((b,i)=>{const row=Math.floor(i/cols),slot=i%cols,zig=row%2?.5:0,base=cols===1?W/2:125+(slot+zig)*((W-250)/Math.max(1,cols-1));const seed=((state.seed||1)^hash(b.ballId)^((i+1)*2654435761))>>>0;const lane=(slot/(Math.max(1,cols-1))-.5);const releaseJitter=Math.floor(rr()*34);return{...b,x:clamp(base+(rr()-.5)*28,116,W-116),y:28-row*spacing,prevX:0,prevY:28-row*spacing,vx:lane*.22+(rr()-.5)*.48,vy:.018+rr()*.045,r:R,releaseAt:now+row*72+(i%7)*13+releaseJitter,done:false,qualified:false,rank:0,lastMoveAt:now,lastMoveY:28-row*spacing,stuckCount:0,ghostUntil:0,stunStart:0,stunUntil:0,stunTriggered:false,stunAnchorY:0,stunCooldownUntil:0,lastWallBounceAt:0,lastGateKickAt:0,finishDropSpeed:0,rngState:seed||1}});for(const b of arr){b.prevX=b.x;b.prevY=b.y}manualCam=null;sim={balls:arr,map:mapDef(state.map,state.seed),finish:[],last:now,startedAt:now,targetMs,hardDeadline:targetMs+30000,acc:0,lastSend:0,paused:false,cam:0,camX:W/2,camZoom:.82,slowRank:0,slowUntil:0,slowedRanks:new Set(),finishFocusUntil:0,finishFlash:null,entrySlowRank:0,entrySlowUntil:0,entrySlowed:new Set(),finishZoomUntil:0,finishZoomStart:0,focusBallId:null,preWinnerFocusRank:0,preWinnerFocusStartedAt:0,completionSent:false,cameraTargetY:0,cameraTargetX:W/2,cameraTargetZoom:1,cameraHoldUntil:0,cameraLastPick:0,cameraReason:'출발',cameraVelocityY:0,cameraVelocityX:0,bottomCameraLocked:false,bottomCameraLockedAt:0,stunGateCooldownUntil:0,jamWatchAt:now,jamZones:new Map(),lastStepAt:now};}
function collideSeg(b,g){const dx=g.x2-g.x1,dy=g.y2-g.y1,L=dx*dx+dy*dy;if(L<.0001)return;const t=clamp(((b.x-g.x1)*dx+(b.y-g.y1)*dy)/L,0,1),cx=g.x1+t*dx,cy=g.y1+t*dy,nx=b.x-cx,ny=b.y-cy,d=Math.hypot(nx,ny);if(d<b.r&&d>0){const ux=nx/d,uy=ny/d,pen=b.r-d;b.x+=ux*pen;b.y+=uy*pen;const vn=b.vx*ux+b.vy*uy;if(vn<0){const now=performance.now(),bounce=clamp(Number(g.b)||.72,.35,1.12);b.vx-=(1+bounce)*vn*ux;b.vy-=(1+bounce)*vn*uy;const speed=Math.hypot(b.vx,b.vy);if(now-(b.lastWallBounceAt||0)>42&&speed>.018){const jitter=(ballRand(b)-.5)*.34,boost=.97+ballRand(b)*.085,c=Math.cos(jitter),sn=Math.sin(jitter),vx=b.vx*c-b.vy*sn,vy=b.vx*sn+b.vy*c;b.vx=vx*boost+ux*(.018+ballRand(b)*.035);b.vy=vy*boost+uy*(.018+ballRand(b)*.035);b.lastWallBounceAt=now}else{b.vx*=.998;b.vy*=.998}}}}
function collidePeg(b,q){let nx=b.x-q.x,ny=b.y-q.y,d=Math.hypot(nx,ny),min=b.r+q.r;if(d<min&&d>0){nx/=d;ny/=d;b.x+=nx*(min-d);b.y+=ny*(min-d);let vn=b.vx*nx+b.vy*ny;if(vn<0){b.vx-=(1+q.b)*vn*nx;b.vy-=(1+q.b)*vn*ny}}}
function collideBalls(a){const grid=new Map(),cs=44,now=performance.now();for(const b of a){if(b.done||now<(b.releaseAt||0))continue;const k=(b.x/cs|0)+','+(b.y/cs|0);(grid.get(k)||grid.set(k,[]).get(k)).push(b)}for(const b of a){if(b.done||now<(b.releaseAt||0))continue;let gx=b.x/cs|0,gy=b.y/cs|0;for(let ix=-1;ix<=1;ix++)for(let iy=-1;iy<=1;iy++)for(const o of grid.get((gx+ix)+','+(gy+iy))||[]){if(o===b||o.done||now<(o.releaseAt||0)||o.ballId<b.ballId)continue;let dx=o.x-b.x,dy=o.y-b.y,d=Math.hypot(dx,dy),m=b.r+o.r;
 // 완전히 같은 좌표에 겹쳤을 때도 임의의 좌우 방향으로 즉시 분리한다.
 if(d<.001){const dir=ballRand(b)<.5?-1:1;dx=dir*.01;dy=.005;d=Math.hypot(dx,dy)}
 let nx=dx/d,ny=dy/d;
 if(d<m){let p=(m-d)/2+.18;b.x-=nx*p;b.y-=ny*p;o.x+=nx*p;o.y+=ny*p;let rv=(o.vx-b.vx)*nx+(o.vy-b.vy)*ny;if(rv<0){let j=-(1+.74)*rv/2;b.vx-=j*nx;b.vy-=j*ny;o.vx+=j*nx;o.vy+=j*ny}}
 // 서로 거의 붙어 이동하는 공에는 약한 좌우 분산력을 줘 큰 덩어리 형성을 줄인다.
 const spread=m*1.9;if(d<spread){const strength=(1-d/spread)*.0048,side=dx===0?(ballRand(b)<.5?-1:1):Math.sign(dx);b.vx-=side*strength;o.vx+=side*strength;b.vy-=strength*.08;o.vy+=strength*.08}
 }}}
function winningTargetRanks(){
 const total=sim?.balls?.length||balls().length;
 if(state?.winMode==='first')return[1];
 if(state?.winMode==='last')return total?[total]:[];
 return(state?.winningRanks||[]).filter(n=>n>0&&n<=total);
}
function updateSlowMotion(now){
 if(!sim||sim.paused)return 1;
 const nextRank=sim.finish.length+1,targets=winningTargetRanks(),fz=sim.map.finalZone;
 const contenders=sim.balls.filter(b=>!b.qualified&&!b.done&&fz&&b.y>fz.gateY-330);
 // 당첨 순번 차례에는 회전바 앞 여러 공을 함께 확대해 "저 공인가, 이 공인가" 경쟁을 보여준다.
 if(targets.includes(nextRank)&&contenders.length&&!sim.slowedRanks.has(nextRank)){
  sim.slowedRanks.add(nextRank);sim.slowRank=nextRank;sim.slowUntil=now+5200;
  sim.finishZoomStart=now;sim.finishZoomUntil=now+5200;
 }
 if(sim.slowRank===nextRank&&targets.includes(nextRank)&&now<sim.slowUntil)return .46;
 if(now>=sim.slowUntil)sim.slowRank=0;
 return 1;
}
function ballRand(b){let x=b.rngState>>>0;x^=x<<13;x^=x>>>17;x^=x<<5;b.rngState=x>>>0;return(b.rngState>>>0)/4294967296}
function step(dt){
 if(!sim||sim.paused)return;
 const now=performance.now(),elapsed=now-sim.startedAt;sim.lastStepAt=now;
 // 공 개수와 무관하게 모든 공에 같은 중력·충돌 규칙을 적용한다.
 const lateBoost=1+clamp((elapsed-sim.targetMs*.78)/(sim.targetMs*.58),0,1)*.52;
 for(const r of sim.map.rot){
  // 프레임이 잠깐 밀려도 회전봉이 순간이동하지 않도록 회전량을 제한한다.
  const frameRatio=clamp(dt/16.67,.35,1.45);
  r.a=(r.a+r.spd*frameRatio)%(Math.PI*2);
 }
 if(sim.map.gate){
  const g=sim.map.gate;
  // 결승 회전바는 공의 충격과 무관하게 한 방향, 일정 속도로 계속 회전한다.
  g.spd=-.034;
  // 회전 전 각도를 저장해 프레임 사이를 쓸어가는 충돌까지 검사한다.
  g.prevA=Number.isFinite(g.a)?g.a:0;
  g.a=(g.a+g.spd*clamp(dt/16.67,.35,1.45))%(Math.PI*2);
 }
 for(const b of sim.balls){
  if(b.done||now<(b.releaseAt||0))continue;
  b.prevX=b.x;b.prevY=b.y;
  const progress=b.y-b.lastMoveY;
  if(progress>13){b.lastMoveY=b.y;b.lastMoveAt=now;b.stuckCount=0}
  // 끼임 해제는 특정 공을 앞으로 보내지 않고, 모든 공에 동일한 조건으로 무작위 방향 충격만 준다.
  if(now-b.lastMoveAt>1800){
   const angle=(ballRand(b)-.5)*Math.PI*.92;
   const power=.42+ballRand(b)*.42;
   b.vx+=Math.sin(angle)*power;
   b.vy+=.34+Math.cos(angle)*power*.38;
   b.stuckCount++;
   b.lastMoveAt=now;
   // 반복해서 낀 경우 아주 짧게 장애물 충돌을 통과시켜 폐쇄된 틈만 빠져나오게 한다.
   if(b.stuckCount>=2)b.ghostUntil=now+220+ballRand(b)*180;
  }
  const fz0=sim.map.finalZone,gate0=sim.map.gate;
  // 결승 통로에서도 일반 물리를 유지해 공들이 벽을 타고 서로 부딪히며 마지막까지 경쟁한다.
  // '무중력'은 공중 부양이 아니라 입구에서 공 3개 이상이 맞물렸을 때 생기는 짧은 스턴이다.
  // 같은 공은 스턴 종료 후 20초 동안 면역이며, 입구 전체도 5초 동안 재발동하지 않는다.
  if(fz0&&gate0&&!b.qualified&&now>=(b.stunCooldownUntil||0)&&now>=(sim.stunGateCooldownUntil||0)&&b.y>fz0.cleanDropTop-115&&b.y<fz0.cleanDropTop+18&&b.x>fz0.chuteLeft-54&&b.x<fz0.chuteRight+54){
   let neighbours=0;
   for(const o of sim.balls){if(o===b||o.done||o.qualified||now<(o.releaseAt||0))continue;const dx=o.x-b.x,dy=o.y-b.y;if(Math.abs(dy)<42&&Math.hypot(dx,dy)<R*2.55)neighbours++}
   // 본인 포함 최소 3개가 맞물려야 하며, 더 많이 몰릴수록 발동 확률이 높아진다.
   const stunChance=neighbours>=3?.72:neighbours>=2?.42:0;
   if(stunChance>0&&!b.stunTriggered&&ballRand(b)<stunChance){
    b.stunTriggered=true;b.stunStart=now;b.stunAnchorY=b.y;b.stunUntil=now+1000+Math.floor(ballRand(b)*800);
    b.stunCooldownUntil=b.stunUntil+20000;
    sim.stunGateCooldownUntil=now+5000;
    b.vx*=.18;b.vy=Math.max(0,b.vy*.10);
   }
  }
  const stunned=now<b.stunUntil;
  if(stunned){
   // 제자리에서 잠깐 맞물리는 느낌만 주고 위로 떠오르지는 않는다.
   b.vx*=.90;b.vy*=.82;b.vy+=.00020*dt;
   b.vy=clamp(b.vy,0,.016);
   if(b.stunAnchorY)b.y+=(b.stunAnchorY-b.y)*.08;
  }else{
   if(b.stunTriggered&&now>=(b.stunUntil||0)){b.stunTriggered=false;b.stunAnchorY=0;b.vx+=(ballRand(b)-.5)*.055;b.vy=Math.max(b.vy,.035+ballRand(b)*.025)}
   b.vy+=.00082*dt*lateBoost;b.vx*=.9989;b.vy*=.99865;
  }
  const prevX=b.x,prevY=b.y;const moveScale=stunned?.16:.66;b.x+=b.vx*dt*moveScale;b.y+=b.vy*dt*moveScale;
  const inFinal=sim.map.finalZone&&b.y>sim.map.finalZone.top-40;const ghost=!inFinal&&now<b.ghostUntil;
  if(!ghost){
   for(const g of sim.map.s)collideSeg(b,g);
   for(const q of sim.map.p)collidePeg(b,q);
   for(const q of sim.map.bum){
    collidePeg(b,{...q,b:.96});const dx=b.x-q.x,dy=b.y-q.y,dd=Math.hypot(dx,dy);
    if(dd<b.r+q.r+3&&dd>0){const boost=q.kick||1.15;b.vx+=(dx/dd)*.2*boost;b.vy+=(dy/dd)*.2*boost}
   }
   for(const q of sim.map.kick||[]){
    const dx=b.x-q.x,dy=b.y-q.y,dd=Math.hypot(dx,dy);
    if(dd<b.r+q.r&&dd>0){b.vx+=q.dir*q.power*.32+(ballRand(b)-.5)*.2;b.vy-=q.power*.14}
   }
   for(const r of sim.map.rot){
    const c=Math.cos(r.a),sn=Math.sin(r.a),g=seg(r.x-c*r.len/2,r.y-sn*r.len/2,r.x+c*r.len/2,r.y+sn*r.len/2,.84);collideSeg(b,g);
    // 회전봉 표면의 실제 접선 방향으로 공을 밀어 준다. 중심부 끼임은 약하게 바깥으로 분리한다.
    const dx=b.x-r.x,dy=b.y-r.y,rad=Math.hypot(dx,dy),along=dx*c+dy*sn;
    if(rad<r.len*.62+b.r){
     const side=along>=0?1:-1,lever=clamp(Math.abs(along)/(r.len*.5),.16,1);
     const tangentX=-sn*side,tangentY=c*side,force=Math.abs(r.spd)*(1.55+lever*2.4);
     b.vx+=tangentX*force;b.vy+=tangentY*force;
     if(rad<30&&rad>0){b.x+=dx/rad*.7;b.y+=dy/rad*.7;b.vx+=dx/rad*.018;b.vy+=dy/rad*.018}
    }
   }
   if(sim.map.gate){
    const g=sim.map.gate,half=g.len/2,barRadius=13;
    // 공과 막대기가 한 프레임 사이에서 서로 지나쳐도 놓치지 않도록
    // 공의 이전→현재 위치와 플리퍼의 이전→현재 각도를 여러 구간으로 나눠 연속 충돌 검사한다.
    let da=g.a-(Number.isFinite(g.prevA)?g.prevA:g.a);
    if(da>Math.PI)da-=Math.PI*2;if(da<-Math.PI)da+=Math.PI*2;
    const travel=Math.hypot(b.x-prevX,b.y-prevY)+Math.abs(da)*half;
    const sweepSteps=clamp(Math.ceil(travel/Math.max(4,b.r*.38)),5,18)|0;
    let gateHit=false,hitData=null;
    for(let si=0;si<=sweepSteps;si++){
     const u=si/sweepSteps,a=(Number.isFinite(g.prevA)?g.prevA:g.a)+da*u,c=Math.cos(a),sn=Math.sin(a);
     const bx=prevX+(b.x-prevX)*u,by=prevY+(b.y-prevY)*u;
     const x1=g.pivotX-c*half,y1=g.pivotY-sn*half,x2=g.pivotX+c*half,y2=g.pivotY+sn*half;
     const vx=x2-x1,vy=y2-y1,L=vx*vx+vy*vy||1;
     const t=clamp(((bx-x1)*vx+(by-y1)*vy)/L,0,1),cx=x1+t*vx,cy=y1+t*vy;
     let dx=bx-cx,dy=by-cy,dist=Math.hypot(dx,dy),hitRadius=b.r+barRadius;
     if(dist<hitRadius){
      if(dist<.001){dx=-sn;dy=c;dist=1}
      const nx=dx/dist,ny=dy/dist;
      // 충돌 시점을 기준으로 공을 막대기 바깥 표면에 정확히 놓아 관통과 끼임을 동시에 방지한다.
      b.x=cx+nx*(hitRadius+.8);b.y=cy+ny*(hitRadius+.8);
      hitData={t,cx,cy,nx,ny,dist,hitRadius,a};gateHit=true;break;
     }
    }
    if(gateHit&&hitData){
     const {t,cx,cy,nx,ny,dist,hitRadius}=hitData,along=(t-.5)*g.len,arm=Math.max(18,Math.abs(along));
     const surfaceVX=-g.spd*(cy-g.pivotY),surfaceVY=g.spd*(cx-g.pivotX);
     const relVx=b.vx-surfaceVX,relVy=b.vy-surfaceVY,vn=relVx*nx+relVy*ny;
     // 회전 표면에 대한 상대속도를 반사해 실제 막대기에 부딪힌 것처럼 확실히 걸리고 튕기게 한다.
     if(vn<.04){const impulse=(1.92)*(.04-vn);b.vx+=nx*impulse;b.vy+=ny*impulse}
     const contact=clamp(1-dist/hitRadius,0,1),upSweep=surfaceVY<-.035;
     b.vx+=surfaceVX*(.92+contact*1.18)+(ballRand(b)-.5)*.035;
     b.vy+=surfaceVY*(1.08+contact*1.34);
     if(upSweep&&now-(b.lastGateKickAt||0)>220){
      const tip=clamp(arm/half,.18,1),kick=.20+.35*tip+.20*contact;
      b.vy=Math.min(b.vy,-kick);
      b.vx+=Math.sign(surfaceVX||along||1)*(.036+.085*tip)+(ballRand(b)-.5)*.045;
      b.lastGateKickAt=now;
     }
    }
   }
  }
  // 공정 레일 강제 가이드: 외벽과 안쪽 길 사이의 빈 공간으로 빠지지 못하게 한다.
  // 현재 높이의 중심선과 폭을 보간해 모든 공이 동일한 안쪽 코스만 타도록 한다.
  if(sim.map.routePts?.length>1&&b.y<sim.map.finalZone.top){
   const pts=sim.map.routePts,ws=sim.map.routeWidths||[];let i=0;
   while(i<pts.length-2&&b.y>pts[i+1][1])i++;
   const a=pts[i],c=pts[Math.min(i+1,pts.length-1)],dy=Math.max(1,c[1]-a[1]),t=clamp((b.y-a[1])/dy,0,1);
   const cx=a[0]+(c[0]-a[0])*t,w=(ws[i]||ws.at(-1)||500)+((ws[Math.min(i+1,ws.length-1)]||ws.at(-1)||500)-(ws[i]||ws.at(-1)||500))*t;
   const margin=b.r+8,left=cx-w*.47+margin,right=cx+w*.47-margin;
   if(b.x<left){b.x=left;b.vx=Math.abs(b.vx)*.70+.018;b.lastWallBounceAt=now}
   if(b.x>right){b.x=right;b.vx=-Math.abs(b.vx)*.70-.018;b.lastWallBounceAt=now}
  }
