   bum.push({x:315,y:y+65,r:25+mr()*9,kick:1.16+mr()*.16});
   bum.push({x:585,y:y+65,r:25+mr()*9,kick:1.16+mr()*.16});
  }else if(kind===2){
   // 좌우 방향이 매번 바뀌는 튕김판
