  if(!node){
   node=document.createElement('div');node.className='rankItem';
   node.innerHTML='<span class="rankNo"></span><span class="colorDot"></span><span class="rankName"></span><span class="rankCopy"></span>';
   rankNodes.set(key,node);
  }
  const hue=(rank*31+318)%360;
  node.style.setProperty('--rainbow',`hsl(${hue} 92% 68%)`);
  node.style.setProperty('--rainbowSoft',`hsl(${hue} 90% 60% / .12)`);
  node.querySelector('.rankNo').textContent=rank;
  node.querySelector('.colorDot').style.setProperty('--dot',`hsl(${hash(b.name)%360} 78% 58%)`);
  node.querySelector('.rankName').textContent=b.name;
  const copyNo=Number.isFinite(Number(b.copy))&&Number(b.copy)>0?Number(b.copy):(Number(String(b.ballId||'').match(/_(\d+)$/)?.[1])||1);node.querySelector('.rankCopy').textContent='#'+copyNo;
    node.classList.toggle('live',!!b.live);node.classList.toggle('preview',!!b.preview);
  const prev=rankStatusCache.get(key);
  if(prev&&prev!=='done'&&status==='done'){
   node.classList.remove('newArrival');void node.offsetWidth;node.classList.add('newArrival');
  }
